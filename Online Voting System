#include <iostream>
using namespace std;

int main() {
    int choice;
    int votesA = 0, votesB = 0, votesC = 0;

    cout << "Online Voting System\n";
    cout << "1. Candidate A\n";
    cout << "2. Candidate B\n";
    cout << "3. Candidate C\n";

    cout << "Enter your vote (1-3): ";
    cin >> choice;

    if(choice == 1) {
        votesA++;
    }
    else if(choice == 2) {
        votesB++;
    }
    else if(choice == 3) {
        votesC++;
    }
    else {
        cout << "Invalid vote";
    }

    cout << "\nVoting Results\n";
    cout << "Candidate A: " << votesA << endl;
    cout << "Candidate B: " << votesB << endl;
    cout << "Candidate C: " << votesC << endl;

    return 0;
}
